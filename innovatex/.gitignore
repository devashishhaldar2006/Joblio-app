# ==========================================
# InnovateX Platform - Git Ignore Rules
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Node.js dependencies & builds
node_modules/
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Tooling cache
.vite/
.eslintcache

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Scratch & test scripts
scratch/
scratch_*
test_market_backend.js

banani-ui-export