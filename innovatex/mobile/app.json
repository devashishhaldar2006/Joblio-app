{
  "expo": {
    "name": "Joblio",
    "slug": "mobile",
    "scheme": "joblio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.devashishcodes.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/splash-icon.png"
          },
          "android": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/splash-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "553e3966-64c8-4055-905a-1253e53c4415"
      }
    },
    "owner": "devashishhaldar2006"
  }
}
