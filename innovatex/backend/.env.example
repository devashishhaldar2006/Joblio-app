# ==============================================================================
# Joblio / InnovateX - Backend Service Environment Variables Example
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.dxg3g8e.mongodb.net/innovatex
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/innovatex

# JSON Web Token Security
JWT_SECRET=your_jwt_secret_key_here

# Python AI Engine Bridge
PYTHON_SERVICE_URL=http://localhost:8000

# CLIST API (Competitive Programming & Contest Tracker)
CLIST_USERNAME=your_clist_username
CLIST_API_KEY=your_clist_api_key