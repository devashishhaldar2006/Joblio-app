# ==============================================================================
# Joblio - Backend Service Environment Variables Example
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/joblio
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/joblio

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_live_your_production_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Python AI Engine Bridge
PYTHON_SERVICE_URL=http://localhost:8000

# CLIST API (Competitive Programming & Contest Tracker)
CLIST_USERNAME=your_clist_username
CLIST_API_KEY=your_clist_api_key

# Resend Email Delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Joblio <onboarding@resend.dev>
