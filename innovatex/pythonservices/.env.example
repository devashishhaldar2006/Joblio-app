# ==============================================================================
# Joblio - Python AI Microservice Environment Variables
# ==============================================================================

# LLM Providers (FastAPI + LangGraph)
# Tier 1 Primary: Groq API Key (Llama 3.3 70B Versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 2 Fallback / Alternative: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Public API Integration (GitHub Profile & Repo Analyzer)
# Generate a Personal Access Token (classic or fine-grained) at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Job Search & Market Demand API (JSearch via RapidAPI)
# Obtain from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# MongoDB Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/joblio
MONGO_DB_NAME=joblio

# Market Forecasting Hyperparameters
PROPHET_SEASONALITY=additive
FORECAST_WEEKS=26
MIN_WEEKS_FOR_ARIMA=12
MIN_WEEKS_FOR_PROPHET=16

# Redis Cache Cluster (e.g. Upstash Redis or Render Redis)
# Example: rediss://default:your_token@your-endpoint.upstash.io:6379
REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379

