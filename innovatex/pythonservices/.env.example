# InnovateX Python AI/ML Microservices Environment Variables Example

# LLM Providers (Tiered Setup)
GEMINI_API_KEY="your_google_gemini_api_key"
GROQ_API_KEY="your_groq_api_key"

# GitHub API (Module 1 Profile Analyzer)
GITHUB_TOKEN="your_github_personal_access_token"

# RapidAPI JSearch (Module 6 Job Market Forecaster)
RAPIDAPI_KEY="your_rapidapi_key"
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# MongoDB Database Connection
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/"
MONGO_DB_NAME="innovatex"

# Forecasting Hyperparameters
PROPHET_SEASONALITY=additive
FORECAST_WEEKS=26
MIN_WEEKS_FOR_ARIMA=12
MIN_WEEKS_FOR_PROPHET=16
